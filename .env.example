# Gmail SMTP. Generate a 16-character App Password at:
#   https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account)
JHB_SMTP_USER=youraddress@gmail.com
JHB_SMTP_PASS=abcdefghijklmnop
JHB_EMAIL_TO=youraddress@gmail.com

# Phase 2 opt-in. Complete private/answer-booklet.json before enabling.
JHB_APPLICATIONS_ENABLED=0
JHB_APPLICATION_EMAIL=0
# Final submission requires a separate explicit approval of each reviewed draft.
JHB_REQUIRE_PORTAL_APPROVAL=1
JHB_PORTAL_SUBMISSIONS_ENABLED=0
# Preserve candidate edits and uploads when they explicitly approve in the portal.
JHB_APPROVE_CURRENT_LIVE_FORM=0
JHB_OVERNIGHT_SUBMISSIONS_ENABLED=0
# Live independent role-fit review uses the existing local Codex login, never CI.
JHB_ROLE_FIT_REVIEW=1
JHB_LINKEDIN_LOCAL_RESOLUTION=0
JHB_HOURLY_PROGRESS_EMAIL=0
# Each cron cycle has bounded work. Pending items persist to later cycles.
JHB_SOURCE_BATCH_SIZE=3
JHB_APPLICATION_BATCH_SIZE=3
JHB_PIPELINE_CONCURRENCY=2
JHB_MAX_ACTIVE_DRAFTS=10
JHB_SOURCE_TIMEOUT_SECONDS=90
JHB_APPLICATION_TIMEOUT_SECONDS=600

# Local Browser Use CLI. Use the endpoint displayed by your running Chrome.
BU_CDP_URL=http://127.0.0.1:52018
BH_HOME=private/browser-use-harness
BH_TELEMETRY=0
